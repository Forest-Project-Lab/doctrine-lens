{
  "schema": "system-map/registry/1",
  "$comment": "M 層の正本のうち、JSON Schema が構造として書けないもの——政策・対象の一覧・段の一覧を持つ。形と語彙は schema.json が正本であり、ここには写さない(spec.mjs が導いて突き合わせる)。データであってコードでないのは意図である: .mjs にすると条件によって門を消せてしまい、それはここが潰そうとしている欠陥そのものになる。",
  "policy": {
    "max_ops": {
      "value": 3,
      "source": "合意台帳 v3.2-16(所有者裁定 2026-08-04)",
      "$comment": "要素からコードまたは証拠への到達に許す操作数。1操作 = 利用者による一回の明示的な起動。"
    },
    "realization_accepted_kinds": {
      "value": [
        "code_range",
        "test"
      ],
      "source": "所有者判定 2026-08-04(#204 §6)・ADR-031 決定4",
      "$comment": "schema.json の TraceAnchor.target_kind の真部分集合であること(spec.mjs が検める)。document・artifact・external_doc は根拠や参照であって、コードまたは試験への到達ではない。"
    },
    "ui_structure": {
      "drillOps": 1,
      "selectOps": 1,
      "extraExpands": 0,
      "linkClickOps": 1,
      "source": "index.html の画面遷移",
      "$comment": "実ブラウザの操作数と一致することは test-m14-browser.mjs が突き合わせる。画面を変えたらここを変える。"
    },
    "status_display_order": {
      "value": [
        "failed",
        "stale",
        "unknown",
        "claimed",
        "planned",
        "verified",
        "not_applicable"
      ],
      "source": "保証画面は重い順に並べる(Phase 1)",
      "$comment": "schema.json の VerificationStatus.enum の並べ替えであること(spec.mjs が検める)。語彙そのものは持たない。"
    }
  },
