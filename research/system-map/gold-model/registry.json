{
  "schema": "system-map/registry/1",
  "$comment": "M 層の正本のうち、JSON Schema が構造として書けないもの——政策・対象の一覧・段の一覧を持つ。形と語彙は schema.json が正本であり、ここには写さない(spec.mjs が導いて突き合わせる)。データであってコードでないのは意図である: .mjs にすると条件によって門を消せてしまい、それはここが潰そうとしている欠陥そのものになる。",
  "policy": {
    "max_ops": {
      "value": 3,
      "source": "合意台帳 v3.2-16(所有者裁定 2026-08-04)",
      "$comment": "要素からコードまたは証拠への到達に許す操作数。1操作 = 利用者による一回の明示的な起動。"
    },
    "realization_accepted_kinds": {
      "value": [
        "code_range",
        "test"
      ],
      "source": "所有者判定 2026-08-04(#204 §6)・ADR-031 決定4",
      "$comment": "schema.json の TraceAnchor.target_kind の真部分集合であること(spec.mjs が検める)。document・artifact・external_doc は根拠や参照であって、コードまたは試験への到達ではない。"
    },
    "ui_structure": {
      "drillOps": 1,
      "selectOps": 1,
      "extraExpands": 0,
      "linkClickOps": 1,
      "source": "index.html の画面遷移",
      "$comment": "実ブラウザの操作数と一致することは test-m14-browser.mjs が突き合わせる。画面を変えたらここを変える。"
    },
    "status_display_order": {
      "value": [
        "failed",
        "stale",
        "unknown",
        "claimed",
        "planned",
        "verified",
        "not_applicable"
      ],
      "source": "保証画面は重い順に並べる(Phase 1)",
      "$comment": "schema.json の VerificationStatus.enum の並べ替えであること(spec.mjs が検める)。語彙そのものは持たない。"
    },
    "overlay_schema": {
      "value": "system-map/overlay/0.1",
      "source": "PR5(複数対象 overlay と配線)",
      "$comment": "実測 overlay の形の名。読み側はこの値でない物を硬く落とす —— 知らない形を「たぶん大丈夫」で読むと、画面が知らない値を実測として印字する。"
    },
    "overlay_statuses": {
      "value": [
        "measured",
        "degraded",
        "unverifiable",
        "no-candidates"
      ],
      "empty_status": "no-candidates",
      "source": "PR5。語彙の由来は overlay/build-overlay.mjs の総括",
      "$comment": "overlay 一件(対象ごと)の総括の状態。`empty_status` は「測る対象が一つも無かった」であり、**記録 0 件と一対一で対応する**。記録が空なのに measured を名乗る物は、何も検めていない合格である(ADR-031 決定5)。"
    },
    "overlay_candidate": {
      "authority": "doctrine",
      "target_kind": "code_range",
      "source": "台帳 v3.2-10(doctrine 対象の鮮度判定は doctrine の機構だけを使う)",
      "$comment": "実測の候補にするアンカーの条件。緩めると第二の鮮度権威を作ることになる。条件を使うのは lib/overlay-candidates.mjs だけである。"
    },
