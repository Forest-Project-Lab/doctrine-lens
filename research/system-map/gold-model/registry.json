  "verdicts": {
    "$comment": "合格の桶に入るのは PASS だけである(ADR-031 決定5)。VACUOUS と SKIP は不合格であって、出所つきの了解の記録が在るときにだけ個別に許す。",
    "PASS": {
      "counts_as_pass": true,
      "note": "見た件数が 1 以上で違反が無い"
    },
    "FAIL": {
      "counts_as_pass": false,
      "note": "違反が在る"
    },
    "VACUOUS": {
      "counts_as_pass": false,
      "note": "見た件数が 0。何も検めていない"
    },
    "SKIP": {
      "counts_as_pass": false,
      "note": "この走行では判定不能。理由を必ず持つ"
    },
    "ERROR": {
      "counts_as_pass": false,
      "note": "検査器が落ちた、または判定を一つも出さなかった"
    }
  },
