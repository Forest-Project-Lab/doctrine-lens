          "op": "add",
          "path": "/anchors/-",
          "value": {
            "id": "a-neg-test-anchor",
            "target_kind": "test",
            "authority": "doctrine",
            "target": "doctrine-lens: src/test/locate.test.ts(実現先の種別 test の正例)",
            "source_revision": "30b060f4aa75c4ba2bc8b303bc71090dd6bf7e49",
            "observed_at": "2026-08-09",
            "url": "https://github.com/Forest-Project-Lab/doctrine-lens/blob/30b060f4aa75c4ba2bc8b303bc71090dd6bf7e49/src/test/locate.test.ts"
          }
        },
        {
          "op": "replace",
          "path": "/elements/@id=lens.model/realized_by",
          "value": [
            "a-neg-test-anchor"
          ]
        }
      ],
      "expect": {
        "checker": "build:reachability",
        "verdict": "PASS"
      }
    },
